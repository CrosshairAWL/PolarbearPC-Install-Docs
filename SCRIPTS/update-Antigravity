#!/usr/bin/env bash

: <<'NOTE'
Interactive updater for Google Antigravity Hub and Antigravity IDE.
Checks latest versions from https://antigravity.google/download/ and downloads via curl.

By Polarbear
NOTE

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_VERSION="2.0.0"

DOWNLOAD_PAGE_URL="https://antigravity.google/download/"
HUB_DIR="/opt/antigravity"
IDE_DIR="/opt/antigravity-ide"

cleanup_tmp_dirs=()
cleanup_sudo_dirs=()

cleanup() {
  local dir
  if (( ${#cleanup_tmp_dirs[@]} > 0 )); then
    for dir in "${cleanup_tmp_dirs[@]}"; do
      [[ -n "$dir" && -d "$dir" ]] && rm -rf "$dir" 2>/dev/null || true
    done
  fi
  if (( ${#cleanup_sudo_dirs[@]} > 0 )); then
    for dir in "${cleanup_sudo_dirs[@]}"; do
      [[ -n "$dir" && -d "$dir" ]] && sudo rm -rf "$dir" 2>/dev/null || true
    done
  fi
}
trap cleanup EXIT

show_help() {
  cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS]

Interactive updater for Antigravity Hub and Antigravity IDE.
Checks https://antigravity.google/download/ and installs updates via curl.

Options:
  -v, --version     Show script and installed Antigravity versions
  -h, --help        Show this help message
EOF
}

detect_arch() {
  case "$(uname -m)" in
    x86_64)
      echo "linux-x64"
      ;;
    aarch64|arm64)
      echo "linux-arm"
      ;;
    *)
      echo "Error: Unsupported architecture '$(uname -m)'." >&2
      exit 1
      ;;
  esac
}

read_asar_version() {
  python3 -c '
import json, struct, sys

data = sys.stdin.buffer.read() if len(sys.argv) < 2 else open(sys.argv[1], "rb").read()
if len(data) < 16:
    sys.exit(1)
_, header_size, _, str_size = struct.unpack("<4I", data[:16])
header = json.loads(data[16:16 + str_size].decode("utf-8"))
pkg = header["files"]["package.json"]
start = 8 + header_size + int(pkg["offset"])
pkg_json = json.loads(data[start:start + pkg["size"]].decode("utf-8"))
version = pkg_json.get("version", "")
if not version:
    sys.exit(1)
print(version)
' "$@"
}

read_product_version() {
  python3 -c '
import json, sys

data = json.load(sys.stdin) if len(sys.argv) < 2 else json.load(open(sys.argv[1], "r", encoding="utf-8"))
version = data.get("ideVersion") or data.get("version") or ""
if not version:
    sys.exit(1)
print(version)
' "$@"
}

get_installed_version() {
  local kind="$1"
  if [[ "$kind" == "hub" ]]; then
    local asar="$HUB_DIR/resources/app.asar"
    [[ -f "$asar" ]] || return 0
    read_asar_version "$asar" 2>/dev/null || true
  else
    local product="$IDE_DIR/resources/app/product.json"
    [[ -f "$product" ]] || return 0
    read_product_version "$product" 2>/dev/null || true
  fi
}

get_archive_version() {
  local kind="$1"
  local archive="$2"
  if [[ "$kind" == "hub" ]]; then
    tar -xzOf "$archive" --no-wildcards-match-slash --wildcards '*/resources/app.asar' 2>/dev/null | read_asar_version 2>/dev/null
  else
    tar -xzOf "$archive" --no-wildcards-match-slash --wildcards '*/resources/app/product.json' 2>/dev/null | read_product_version 2>/dev/null
  fi
}

show_version() {
  local hub_ver ide_ver
  hub_ver="$(get_installed_version hub)"
  ide_ver="$(get_installed_version ide)"
  echo "$SCRIPT_NAME $SCRIPT_VERSION"
  echo "Antigravity Hub: ${hub_ver:-not installed}"
  echo "Antigravity IDE: ${ide_ver:-not installed}"
}

compare_versions() {
  local installed="$1"
  local latest="$2"

  if [[ -z "$latest" ]]; then
    echo "unavailable"
    return
  fi
  if [[ -z "$installed" ]]; then
    echo "install"
    return
  fi
  if [[ "$installed" == "$latest" ]]; then
    echo "same"
    return
  fi
  if [[ "$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | tail -n 1)" == "$latest" ]]; then
    echo "newer"
  else
    echo "older"
  fi
}

fetch_online_releases() {
  local arch="$1"
  local html parsed

  hub_latest=""
  hub_url=""
  ide_latest=""
  ide_url=""
  online_ok=false

  echo "Checking latest versions online..."
  if ! html="$(curl -fsSL --max-time 15 "$DOWNLOAD_PAGE_URL" 2>/dev/null)"; then
    echo "Warning: Could not reach $DOWNLOAD_PAGE_URL." >&2
    return 0
  fi

  if ! parsed="$(printf '%s' "$html" | python3 -c '
import re, sys

arch = re.escape(sys.argv[1])
html = sys.stdin.read()

hub_re = re.compile(r"https://[^\s\"'\''<>]+/(\d+(?:\.\d+)+)[^\s\"'\''<>]*/" + arch + r"/Antigravity\.tar\.gz")
ide_re = re.compile(r"https://[^\s\"'\''<>]+/(\d+(?:\.\d+)+)[^\s\"'\''<>]*/" + arch + r"/Antigravity%20IDE\.tar\.gz")

hub_m = hub_re.search(html)
ide_m = ide_re.search(html)

hub_ver = hub_m.group(1) if hub_m else ""
hub_u = hub_m.group(0) if hub_m else ""
ide_ver = ide_m.group(1) if ide_m else ""
ide_u = ide_m.group(0) if ide_m else ""

print(f"{hub_ver}\t{hub_u}")
print(f"{ide_ver}\t{ide_u}")
' "$arch" 2>/dev/null)"; then
    echo "Warning: Could not parse release info from $DOWNLOAD_PAGE_URL." >&2
    return 0
  fi

  IFS=$'\t' read -r hub_latest hub_url <<< "$(printf '%s\n' "$parsed" | sed -n '1p')"
  IFS=$'\t' read -r ide_latest ide_url <<< "$(printf '%s\n' "$parsed" | sed -n '2p')"

  if [[ -n "$hub_latest" || -n "$ide_latest" ]]; then
    online_ok=true
  fi
}

refresh_local_state() {
  hub_installed="$(get_installed_version hub)"
  ide_installed="$(get_installed_version ide)"

  hub_cmp="$(compare_versions "$hub_installed" "$hub_latest")"
  ide_cmp="$(compare_versions "$ide_installed" "$ide_latest")"

  hub_avail=false
  ide_avail=false

  case "$hub_cmp" in
    install)     hub_status="Not installed";    hub_avail=true ;;
    newer)       hub_status="Update available"; hub_avail=true ;;
    same)        hub_status="Up to date" ;;
    older)       hub_status="Newer installed" ;;
    unavailable) hub_status="Check failed" ;;
  esac

  case "$ide_cmp" in
    install)     ide_status="Not installed";    ide_avail=true ;;
    newer)       ide_status="Update available"; ide_avail=true ;;
    same)        ide_status="Up to date" ;;
    older)       ide_status="Newer installed" ;;
    unavailable) ide_status="Check failed" ;;
  esac
}

is_running_inside() {
  local target_dir="$1"
  local pid="$$"
  local exe ppid

  while [[ -n "$pid" && "$pid" -gt 1 ]]; do
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    if [[ "$exe" == "$target_dir"/* ]]; then
      return 0
    fi
    ppid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)"
    [[ -n "$ppid" && "$ppid" != "$pid" ]] || break
    pid="$ppid"
  done
  return 1
}

stop_app() {
  local target_dir="$1"
  local pids=()
  local proc_dir pid exe

  for proc_dir in /proc/[0-9]*; do
    pid="${proc_dir#/proc/}"
    [[ "$pid" == "$$" || "$pid" == "$BASHPID" ]] && continue
    exe="$(readlink -f "$proc_dir/exe" 2>/dev/null || true)"
    if [[ "$exe" == "$target_dir"/* ]]; then
      pids+=("$pid")
    fi
  done

  if (( ${#pids[@]} == 0 )); then
    return 0
  fi

  echo "Stopping running processes in $target_dir..."
  kill -TERM "${pids[@]}" 2>/dev/null || true

  local i alive
  for (( i = 0; i < 10; i++ )); do
    alive=0
    for pid in "${pids[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        alive=1
        break
      fi
    done
    (( alive == 0 )) && return 0
    sleep 0.5
  done

  kill -KILL "${pids[@]}" 2>/dev/null || true
  sleep 0.2
}

install_component() {
  local kind="$1"
  local label="$2"
  local url="$3"
  local target_dir="$4"
  local old_ver="$5"

  local tmp_dir part_file archive archive_ver stage_dir backup_dir
  tmp_dir="$(mktemp -d /tmp/update-antigravity.XXXXXX)"
  cleanup_tmp_dirs+=("$tmp_dir")

  part_file="$tmp_dir/${kind}.tar.gz.part"
  archive="$tmp_dir/${kind}.tar.gz"
  stage_dir="${target_dir}.new.$$"
  backup_dir="${target_dir}.bak.$$"
  cleanup_sudo_dirs+=("$stage_dir")

  echo ""
  echo "Downloading $label..."
  if ! curl -fL# --max-time 600 -o "$part_file" "$url"; then
    echo "Error: Failed to download $label." >&2
    rm -rf "$tmp_dir"
    return 1
  fi
  mv "$part_file" "$archive"

  if ! archive_ver="$(get_archive_version "$kind" "$archive")" || [[ -z "$archive_ver" ]]; then
    echo "Error: Downloaded archive for $label is invalid or corrupted." >&2
    rm -rf "$tmp_dir"
    return 1
  fi

  echo "Installing $label ($archive_ver)..."
  sudo mkdir -p "$stage_dir"
  if ! sudo tar --no-same-owner -xzf "$archive" -C "$stage_dir" --strip-components=1; then
    echo "Error: Failed to extract $label." >&2
    rm -rf "$tmp_dir"
    sudo rm -rf "$stage_dir"
    return 1
  fi

  stop_app "$target_dir"

  if [[ -d "$target_dir" ]]; then
    sudo mv "$target_dir" "$backup_dir"
  fi

  if ! sudo mv "$stage_dir" "$target_dir"; then
    echo "Error: Failed to swap $label into $target_dir; restoring previous version..." >&2
    if [[ -d "$backup_dir" ]]; then
      sudo mv "$backup_dir" "$target_dir"
    fi
    rm -rf "$tmp_dir"
    return 1
  fi

  if [[ -d "$backup_dir" ]]; then
    sudo rm -rf "$backup_dir"
  fi

  rm -rf "$tmp_dir"

  local new_ver
  new_ver="$(get_installed_version "$kind")"
  echo "Updated $label: ${old_ver:-not installed} -> ${new_ver:-$archive_ver}"
}

run_selected_updates() {
  local targets=("$@")
  local target dir label

  echo ""
  echo "Selected update(s):"
  for target in "${targets[@]}"; do
    if [[ "$target" == "hub" ]]; then
      echo "  - Antigravity Hub: ${hub_installed:-not installed} -> $hub_latest"
    else
      echo "  - Antigravity IDE: ${ide_installed:-not installed} -> $ide_latest"
    fi
  done

  echo ""
  read -r -p "Proceed with download and update? [y/N] " reply || return 0
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "Update cancelled."
    return 0
  fi

  for target in "${targets[@]}"; do
    if [[ "$target" == "hub" ]]; then
      dir="$HUB_DIR"
      label="Antigravity Hub"
    else
      dir="$IDE_DIR"
      label="Antigravity IDE"
    fi
    if is_running_inside "$dir"; then
      echo "" >&2
      echo "Error: This script is running inside $label." >&2
      echo "Updating it would terminate this terminal mid-install. Run from an external terminal instead." >&2
      return 1
    fi
  done

  if ! sudo -v; then
    echo "Error: sudo authentication failed." >&2
    return 1
  fi

  for target in "${targets[@]}"; do
    if [[ "$target" == "hub" ]]; then
      install_component hub "Antigravity Hub" "$hub_url" "$HUB_DIR" "$hub_installed" || return 1
    else
      install_component ide "Antigravity IDE" "$ide_url" "$IDE_DIR" "$ide_installed" || return 1
    fi
  done

  refresh_local_state
}

print_dashboard() {
  echo ""
  echo "Antigravity Updater (v$SCRIPT_VERSION)"
  echo "───────────────────────────────────────────────────────"
  printf "%-18s %-12s %-10s %s\n" "Component" "Installed" "Latest" "Status"
  printf "%-18s %-12s %-10s %s\n" "Antigravity Hub" "${hub_installed:-not found}" "${hub_latest:--}" "$hub_status"
  printf "%-18s %-12s %-10s %s\n" "Antigravity IDE" "${ide_installed:-not found}" "${ide_latest:--}" "$ide_status"
  echo "───────────────────────────────────────────────────────"

  if $hub_avail; then
    if [[ "$hub_cmp" == "install" ]]; then
      echo "1) Install Antigravity Hub ($hub_latest)"
    else
      echo "1) Update Antigravity Hub ($hub_installed -> $hub_latest)"
    fi
  fi

  if $ide_avail; then
    if [[ "$ide_cmp" == "install" ]]; then
      echo "2) Install Antigravity IDE ($ide_latest)"
    else
      echo "2) Update Antigravity IDE ($ide_installed -> $ide_latest)"
    fi
  fi

  if $hub_avail && $ide_avail; then
    echo "3) Update Both (Hub & IDE)"
  fi

  if ! $hub_avail && ! $ide_avail; then
    if $online_ok; then
      echo "Everything is already up to date."
    else
      echo "Could not fetch latest versions online."
    fi
    echo ""
  fi

  echo "r) Re-check online"
  echo "0) Exit"
}

show_banner() {
  cat << 'EOF'
  _    ___  \   /   |  |  __   __    _   _____  ___  __
 /_\  / __   \ /    |  | |__| |  \  /_\    |   |__  |__/
/   \ \___|   |     \__/ |    |__/ /   \   |   |___ |  \

                By Polarbear and Gemini

EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--version)
      show_version
      exit 0
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Run '$SCRIPT_NAME --help' for usage." >&2
      exit 2
      ;;
  esac
done

show_banner
ARCH="$(detect_arch)"
fetch_online_releases "$ARCH"
refresh_local_state

while true; do
  print_dashboard
  echo ""
  if ! read -r -p "Choose an option: " choice; then
    echo ""
    exit 0
  fi

  case "$choice" in
    1)
      if $hub_avail; then
        run_selected_updates hub || true
      else
        echo "Antigravity Hub has no update available."
      fi
      ;;
    2)
      if $ide_avail; then
        run_selected_updates ide || true
      else
        echo "Antigravity IDE has no update available."
      fi
      ;;
    3)
      if $hub_avail && $ide_avail; then
        run_selected_updates hub ide || true
      else
        echo "Both components must have updates available for option 3."
      fi
      ;;
    r|R)
      echo ""
      fetch_online_releases "$ARCH"
      refresh_local_state
      ;;
    0|q|Q)
      exit 0
      ;;
    *)
      echo "Invalid option: $choice"
      ;;
  esac
done
